# Inject with your shell or container; the CLI does not automatically read .env.
# No default provider is selected until Gemini / DeepSeek evaluations are complete.
RESUME_AI_PROVIDER=deepseek
# RESUME_AI_MODEL=  # optional; omit to use the selected provider preset
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
RESUME_JEV_MODEL=jev-1.13.0
RESUME_LOG_LEVEL=info
# Independent baseline comparison only:
OPENAI_API_KEY=
KIMI_API_KEY=
# Optional HTTPS endpoints (normal vendor defaults are used if unset):
# RESUME_AI_BASE_URL=
# TYPESAFE_BASE_URL=
