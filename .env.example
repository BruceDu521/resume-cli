# Inject with your shell or container; the CLI does not automatically load .env.
# One selected model and one API key.
RESUME_AI_PROVIDER=deepseek
RESUME_AI_API_KEY=
# RESUME_AI_MODEL=deepseek-flash
RESUME_LOG_LEVEL=info
# Optional HTTPS endpoint override:
# RESUME_AI_BASE_URL=
# Kimi Code subscription: provider=kimi, model=k3,
# RESUME_AI_BASE_URL=https://api.kimi.com/coding/v1
# Kimi open platform: model=kimi-k3, default https://api.moonshot.ai/v1
