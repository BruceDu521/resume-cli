# Inject with your shell or container; the CLI does not automatically read .env.
# Example cost-first scoring route; CLI has no global default. See docs/evaluation-results-2026-09-20.md.
RESUME_AI_PROVIDER=deepseek
# single: one provider/key; hybrid: selected provider + TYPESAFE_API_KEY
RESUME_AI_PIPELINE=hybrid
# RESUME_AI_MODEL=  # optional; omit to use the selected provider preset
# Credential for RESUME_AI_PROVIDER; replace it when switching providers.
RESUME_AI_API_KEY=
TYPESAFE_API_KEY=
RESUME_JEV_MODEL=jev-1.13.0
RESUME_LOG_LEVEL=info
# Kimi API: provider=kimi, model=kimi-k3, API base https://api.moonshot.ai/v1 or .cn/v1
# Kimi Code subscription: provider=kimi, model=k3, API base https://api.kimi.com/coding/v1
# Use --base-url for a one-off region/product override; keys are not interchangeable.
# Optional HTTPS endpoints (normal vendor defaults are used if unset):
# RESUME_AI_BASE_URL=
# TYPESAFE_BASE_URL=
